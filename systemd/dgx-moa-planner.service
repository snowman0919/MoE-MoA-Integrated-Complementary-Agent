[Unit]
Description=DGX MoA planner
PartOf=dgx-moa-resident.target
Before=dgx-moa-resident.target
After=dgx-moa-executor.service
Conflicts=dgx-moa-judge.service dgx-moa-judge.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/kotori9/dgx-moa-agent
ExecStartPre=/home/kotori9/dgx-moa-agent/scripts/wait-model.sh executor
ExecStartPre=-/usr/bin/docker rm -f dgx-moa-sglang-planner
ExecStart=/usr/bin/docker run --rm --name dgx-moa-sglang-planner --pull never --gpus all --network bridge -p 127.0.0.1:8102:8102 --memory 45g --memory-swap 45g --oom-score-adj 1000 -v /home/kotori9/models/specialist-unified-qwen36-27b-nvfp4:/model:ro -v dgx-moa-sglang-cache:/root/.cache lmsysorg/sglang:dev-cu13@sha256:26f620b13e49900cc6ab59ed693f9ce8f9ea4f3531074c1e39a3bf9db06ab8f0 python -m sglang.launch_server --model-path /model --host 0.0.0.0 --port 8102 --served-model-name dgx-moa-planner --context-length 65536 --mem-fraction-static 0.68 --max-running-requests 1 --max-total-tokens 65536 --max-mamba-cache-size 5 --quantization modelopt --language-only --cuda-graph-backend-decode disabled --cuda-graph-backend-prefill disabled --reasoning-parser qwen3 --enable-metrics --enable-cache-report
ExecStartPost=/home/kotori9/dgx-moa-agent/scripts/wait-model.sh planner
ExecStop=-/usr/bin/docker stop -t 180 dgx-moa-sglang-planner
Restart=on-failure
RestartSec=5
TimeoutStartSec=3600
TimeoutStopSec=180
KillSignal=SIGTERM
SuccessExitStatus=0 143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/kotori9/dgx-moa-agent
ReadWritePaths=/home/kotori9/models
ReadWritePaths=%t/dgx-moa
RuntimeDirectory=dgx-moa
LockPersonality=true
RestrictSUIDSGID=true
