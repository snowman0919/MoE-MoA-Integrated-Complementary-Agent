DGX_MOA_AUTH_ENABLED=true
DGX_MOA_API_KEY=replace-with-a-long-random-token
# Preferred multi-token form. Values are secrets; IDs are safe usage labels.
# DGX_MOA_API_KEYS='{"opencode":"replace-with-token-a","hermes":"replace-with-token-b"}'
DGX_MOA_ADMIN_API_ENABLED=false
# Only these configured key IDs start with administrator privileges.
DGX_MOA_ADMIN_TOKEN_IDS='["operator"]'
DGX_MOA_MAX_ADMIN_API_KEYS=3
DGX_MOA_BIND_HOST=127.0.0.1
DGX_MOA_BIND_PORT=9000
# Optional overrides for gateway.model_routing.
# DGX_MOA_EXECUTOR_MODEL=local/executor
# DGX_MOA_EXECUTOR_FALLBACK_MODEL=opencode/muse-spark-1.3-contributor
# DGX_MOA_EXECUTOR_FALLBACK_API=responses
# DGX_MOA_EXECUTOR_ROLLBACK_MODEL=opencode/deepseek-v4-flash
# DGX_MOA_PLANNER_MODEL=opencode/deepseek-v4-pro
# DGX_MOA_REVIEWER_MODEL=opencode/glm-5.2
# DGX_MOA_REASONER_MODEL=ollama/Qwythos-v2-9B:Q4
# DGX_MOA_JUDGE_MODEL=opencode/kimi-k3
# DGX_MOA_FRONTIER_A_MODEL=codex/gpt-5.6-sol
# Set gateway.model_routing.frontier_b to null in YAML to disable it.
DGX_MOA_EXECUTOR_MAX_MODEL_LEN=16384
DGX_MOA_PLANNER_MAX_MODEL_LEN=8192
DGX_MOA_REVIEWER_MAX_MODEL_LEN=8192
DGX_MOA_JUDGE_MAX_MODEL_LEN=8192
DGX_MOA_EXECUTOR_GPU_MEMORY_UTILIZATION=0.50
DGX_MOA_EXECUTOR_ENFORCE_EAGER=false
DGX_MOA_EXECUTOR_MOE_BACKEND=cutlass
DGX_MOA_PLANNER_GPU_MEMORY_UTILIZATION=0.25
DGX_MOA_REVIEWER_GPU_MEMORY_UTILIZATION=0.25
DGX_MOA_JUDGE_GPU_MEMORY_UTILIZATION=0.85
DGX_MOA_JUDGE_KV_CACHE_MEMORY_BYTES=4000000000
DGX_MOA_MAX_NUM_SEQS=1
DGX_MOA_MODEL_START_TIMEOUT=3600
DGX_MOA_MEMORY_SETTLE_SECONDS=10
DGX_MOA_CONFIG=config/models.yaml
DGX_MOA_STATE_DB=data/state/gateway.db
MODEL_ROOT=/home/kotori9/models/dgx-moa
HF_HOME=/home/kotori9/models/.hf-cache
